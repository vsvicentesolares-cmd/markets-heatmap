\njson.dump({'rows':rows,'meta':[{'label':'build_cds.py','value':open(__file__).read(),'type':'code','lang':'python'},{'label':'Read','value':'2026-11-14'}]},open('compass_cds.json','w'),separators=(',',':'))\nfor c in ['US','ES','UK','MX']:\n    r=[x for x in rows if x['country']==c]; print(c,len(r),r[0]['month'],r[-1]['month'],r[-2]['cds_5y'],max(x['cds_5y'] for x in r))\n","type":"code","lang":"python"},{"label":"Read","value":"2026-11-14"}]}